// Stashly broker — data model
// Note: the broker NEVER stores plaintext file content or unwrapped encryption
// keys. `encryptedDek` and any cached blobs are opaque ciphertext produced by
// the client/device; only paired devices hold the master key needed to decrypt them.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  mfaEnabled   Boolean  @default(false)
  mfaSecretCiphertext String?

  userDevices    UserDevice[]
  pairingTokens  PairingToken[]
  shareLinks     ShareLink[]
  auditEvents    AuditLog[] @relation("AuditActor")
}

model ShareLink {
  id        String   @id @default(uuid())
  ownerId   String
  deviceId  String
  fileId    String?
  scopeMode String   @default("CUSTOM_FILE")
  scopePath String?
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastAccessAt DateTime?
  accessCount Int @default(0)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  file FileEntry? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  @@index([ownerId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid())
  actorUserId String?
  action String
  targetType String?
  targetId String?
  metadata String?
  ipAddress String?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Device {
  id             String      @id @default(uuid())
  name           String      // e.g. "Vedant's Pixel 8"
  platform       String      @default("android") // "android" | "windows" | "ios" | "linux"
  status         String      @default("offline") // "online" | "offline"
  sharingPaused  Boolean     @default(false)
  lastSeenAt     DateTime?
  storageQuotaMb Int         @default(0) // how much local storage this device has offered
  createdAt      DateTime    @default(now())

  files       FileEntry[]
  userDevices UserDevice[]
  shares ShareLink[]
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  role      String   @default("owner") // "owner" | "viewer" | "editor"
  scopeMode String   @default("ALL") // "ALL" | "CUSTOM_FOLDER" | "CUSTOM_FILE"
  scopePath String?
  scopeName String?
  sharingEnabled Boolean @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

model FileEntry {
  id            String    @id @default(uuid())
  deviceId      String
  path          String    // virtual path, e.g. "/Documents/report.pdf"
  name          String
  sizeBytes     Int
  contentHash   String    // hash of the CIPHERTEXT, for integrity checks only
  mimeType      String?
  encryptedDek  String    // wrapped per-file data key, opaque to the broker
  isCached      Boolean   @default(false)
  cacheKey      String?   // pointer into local file storage or blob storage
  cachedAt      DateTime?
  cachedContentHash String?
  lastAccessAt  DateTime?
  encryptionFormat String @default("single") // "single" = legacy whole-file AES-GCM, "chunked" = independently encrypted chunks
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  versions      FileVersion[]
  shares ShareLink[]

  @@unique([deviceId, path])
  @@index([deviceId])
  @@index([deviceId, deletedAt])
}

model FileVersion {
  id            String   @id @default(uuid())
  fileId        String
  deviceId      String
  path          String
  name          String
  sizeBytes     Int
  contentHash   String
  mimeType      String?
  encryptedDek  String
  cacheKey      String?
  createdAt     DateTime  @default(now())

  file FileEntry @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, createdAt])
  @@index([deviceId])
}

model UploadSession {
  id            String   @id @default(uuid())
  userId        String
  deviceId      String
  path          String
  name          String
  mimeType      String?
  encryptedDek  String
  totalBytes    Int
  totalChunks   Int      @default(1)
  encryptionFormat String @default("single")
  receivedBytes Int      @default(0)
  chunkCount    Int      @default(0)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime

  @@index([userId, deviceId])
  @@index([expiresAt])
}

model PairingToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
