# ==============================================================================
# Stashly Broker Server - Environment Configuration Template
# ==============================================================================

# Server Network & Environment
PORT=4000
NODE_ENV=development

# Optional Public / Deployed URL (e.g. for Render, Cloud Run, or custom domain):
# PUBLIC_URL=https://stashly-broker.onrender.com

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stashly?schema=public"

# Authentication & JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Dedicated AES-256 key for encrypting MFA/TOTP secrets. Generate a random
# value and persist it: losing it locks out all MFA-enabled users.
MFA_ENCRYPTION_KEY="replace-with-a-persisted-random-32-byte-value"

# Device Pairing Token Time-To-Live (seconds)
PAIRING_TOKEN_TTL_SECONDS=300

# Device Fetch / Relay Timeout (milliseconds)
DEVICE_FETCH_TIMEOUT_MS=15000

# Rate Limiting (maximum requests per 15-minute window per IP)
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_PAIR_MAX=40

# Local Storage Cache Directory (optional override)
# STORAGE_DIR=storage/cache
