# Server
PORT=4000
NODE_ENV=development

# On Render, set this to the deployed broker URL:
# PUBLIC_URL=https://nimbusnode-broker.onrender.com

# PostgreSQL database used in development and production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nimbusnode?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Device pairing tokens are short-lived, single-use
PAIRING_TOKEN_TTL_SECONDS=300

# How long the broker waits for a phone to respond to a fetch request
DEVICE_FETCH_TIMEOUT_MS=15000
