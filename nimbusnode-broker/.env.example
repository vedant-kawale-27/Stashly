# Server
PORT=4000
NODE_ENV=development

# Database (SQLite by default for easy local dev; swap to Postgres in prod)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Device pairing tokens are short-lived, single-use
PAIRING_TOKEN_TTL_SECONDS=300

# How long the broker waits for a phone to respond to a fetch request
DEVICE_FETCH_TIMEOUT_MS=15000
